{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aem-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@adobe/aem-cli",
        "up",
        "--no-open",
        "--forward-browser-logs",
        "--html-folder",
        "drafts"
      ],
      "port": 3000
    },
    {
      "name": "nav-app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "nav-app",
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "edge-nav-serve",
      "runtimeExecutable": "fastly",
      "runtimeArgs": [
        "compute",
        "serve",
        "--dir",
        "edge-nav",
        "--file",
        "bin/main.wasm",
        "--skip-build",
        "--addr",
        "127.0.0.1:7676",
        "--non-interactive"
      ],
      "port": 7676
    }
  ]
}
