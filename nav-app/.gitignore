# App Builder workspace credentials — written by `aio app use`, never commit
.env
.aio

# workspace JSON downloaded from Developer Console (e.g. 703CoralCanid-4191536-Stage.json) can
# hold credentials; it lands in this folder, so ignore any JSON here except the npm manifests
/*.json
!/package.json
!/package-lock.json

# written by `aio app deploy`: temporary storage credentials for the static upload
.aws.tmp.creds.json

# generated by aio at build time
web-src/src/config.json

node_modules/
dist/
.parcel-cache/
